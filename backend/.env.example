NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/friday
DB_POOL_MAX=10
WORKER_POLL_MS=1000
WORKER_STALE_TASK_MS=300000
AUTH_SESSION_DAYS=7
FILE_STORAGE_DIR=./storage
FILE_MAX_BYTES=10485760
CODE_WORKSPACE_ROOT=.
CODE_ALLOWED_COMMANDS=npm test,npm run build
CODE_COMMAND_TIMEOUT_MS=120000
CODE_MAX_OUTPUT_BYTES=500000
FRIDAY_ALLOW_CODE_EXECUTION=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
FRIDAY_ALLOW_GITHUB_MUTATIONS=false
